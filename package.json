{
  "name": "clinic-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
    "scripts": {
      "dev": "vite",
      "dev:electron": "vite --mode electron",
      "build": "vue-tsc -b && vite build",
      "build:electron": "vue-tsc -b && vite build --mode electron",
      "preview": "vite preview",
      "dist:mac": "npm run build:electron && electron-builder --mac",
      "dist:win": "npm run build:electron && electron-builder --win",
      "dist:linux": "npm run build:electron && electron-builder --linux"
  },
  "build": {
    "appId": "dev.dasmido.clinicdesktop",
    "productName": "ClinicDesktop",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue-tsc": "^3.3.11"
  }
}
