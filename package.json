{
  "name": "clinic-desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run dev:electron",
    "dev:renderer": "vite",
    "dev:electron": "vite --mode electron",
    "build": "npm run build:electron",
    "build:renderer": "vue-tsc -b && vite build",
    "build:electron": "vue-tsc -b && vite build --mode electron",
    "clean:release": "node -e \"require('node:fs').rmSync('release', { recursive: true, force: true })\"",
    "dist:mac": "npm run clean:release && npm run build:electron && electron-builder --mac --arm64",
    "dist:win": "npm run clean:release && npm run build:electron && electron-builder --win",
    "dist:linux": "npm run clean:release && npm run build:electron && electron-builder --linux"
  },
  "build": {
    "appId": "dev.dasmido.clinicdesktop",
    "productName": "ClinicDesktop",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "src/database/migrations/*.sql",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "src/database/migrations",
        "to": "database/migrations",
        "filter": [
          "*.sql"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "src/database/migrations",
          "to": "database/migrations",
          "filter": [
            "*.sql"
          ]
        },
        {
          "from": "node_modules/@embedded-postgres/darwin-arm64/native",
          "to": "postgres/darwin-arm64/native"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "kysely": "^0.29.5"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@nuxt/ui": "^4.11.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "bcryptjs": "^3.0.3",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg": "^8.23.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  }
}
